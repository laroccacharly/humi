{
  "name": "humi",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "bin": {
    "humi": "./src/index.ts"
  },
  "type": "module",
  "scripts": {
    "humi": "bun ./src/index.ts",
    "test": "bun test",
    "postinstall": "[ \"$(\"$HOME/.cache/lightpanda-node/lightpanda\" version 2>/dev/null)\" = 1.0.0 ] || lightpanda install 1.0.0",
    "lint": "bun --bun oxlint . && ts-lint-effect",
