    "format": "oxfmt .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@effect/platform-browser": "4.0.0",
    "@effect/platform-bun": "4.0.0",
    "@effect/sql-sqlite-bun": "4.0.0",
    "echarts": "^6.1.0",
    "effect": "4.0.0",
    "effect-lib": "github:laroccacharly/effect-lib#v0.9.0",
    "foldkit": "0.168.0",
    "vite": "^8.3.4"
  },
  "devDependencies": {
    "@foldkit/oxlint-plugin": "^0.15.3",
    "@lightpanda/browser": "^1.6.0",
    "@types/bun": "^1.4.2",
    "oxfmt": "^0.65.0",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7",
    "playwright-core": "^1.63.0",
    "ts-lint": "github:laroccacharly/ts-lint#v0.5.0",
    "typescript": "^7.0.2",
    "ultracite": "^7.11.1"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.0",
    "@oxlint/plugins": "$oxlint"
